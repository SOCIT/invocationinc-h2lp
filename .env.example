# Stripe (required for live checkout via /api/checkout)
STRIPE_SECRET_KEY=sk_test_...

# Stripe Price ID — the active one-time $9.99 ebook Price. Not the retired $19.97 Price.
# Do NOT hardcode Price IDs in source. Checkout product ids: book only.
# If this still names the retired Price, checkout uses the active $9.99 Price on that same product.
# Catalog price is $9.99 (999¢). No list price. No promo code on the page. No bundle.
STRIPE_PRICE_BOOK=price_...

# Public site URL (no trailing slash) — used for Checkout success/cancel redirects
# Local: http://localhost:3000
# Production: https://invocationinc-h2lp.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: newsletter signup webhook (POST JSON { email, source, ts })
# If unset, /api/subscribe validates + logs email and still returns 200.
NEWSLETTER_WEBHOOK_URL=
